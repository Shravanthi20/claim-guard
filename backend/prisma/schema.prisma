generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  cognitoSub         String?             @unique
  name               String
  email              String              @unique
  role               UserRole            @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  claims             Claim[]
  investigations     Investigation[]     @relation("InvestigatorClaims")
  investigationNotes InvestigationNote[]
  policies           Policy[]
}

model Policy {
  id             String   @id @default(uuid())
  policyNumber   String   @unique
  type           String
  coverageAmount Float
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  userId         String
  claims         Claim[]
  user           User     @relation(fields: [userId], references: [id])
}

model Claim {
  id             String          @id @default(uuid())
  claimNumber    String          @unique
  title          String
  description    String
  claimedAmount  Float
  status         ClaimStatus     @default(SUBMITTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  policyId       String?
  policy         Policy?         @relation(fields: [policyId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  events         ClaimEvent[]
  evidence       Evidence[]
  investigation  Investigation?
  riskAssessment RiskAssessment?
}

model Evidence {
  id          String   @id @default(uuid())
  fileName    String
  fileType    String
  s3Key       String?
  description String?
  uploadedAt  DateTime @default(now())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Investigation {
  id             String              @id @default(uuid())
  status         InvestigationStatus @default(OPEN)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  claimId        String              @unique
  investigatorId String?
  claim          Claim               @relation(fields: [claimId], references: [id], onDelete: Cascade)
  investigator   User?               @relation("InvestigatorClaims", fields: [investigatorId], references: [id])
  notes          InvestigationNote[]
}

model InvestigationNote {
  id              String        @id @default(uuid())
  content         String
  createdAt       DateTime      @default(now())
  investigationId String
  investigatorId  String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  investigator    User          @relation(fields: [investigatorId], references: [id])
}

model RiskAssessment {
  id                 String    @id @default(uuid())
  riskLevel          RiskLevel
  riskScore          Float
  fraudProbability   Float?
  modelVersion       String?
  riskFactors        Json?
  aiProcessingStatus String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  claimId            String    @unique
  claim              Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model ClaimEvent {
  id          String   @id @default(uuid())
  eventType   String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

enum UserRole {
  CUSTOMER
  INVESTIGATOR
  ADMIN
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
}

enum InvestigationStatus {
  OPEN
  IN_PROGRESS
  ADDITIONAL_INFO_REQUIRED
  COMPLETED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
